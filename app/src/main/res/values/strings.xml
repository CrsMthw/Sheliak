    <string name="intro_continue">Continue</string>

    <!-- Library tabs. Each tab's bar subtitle is its own count: "12 tracks", "3 albums", "5 artists", "2 playlists". -->
    <plurals name="library_track_count">
        <item quantity="one">%1$d track</item>
        <item quantity="other">%1$d tracks</item>
