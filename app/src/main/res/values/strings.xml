    <plurals name="library_album_count">
        <item quantity="one">%1$d album</item>
        <item quantity="other">%1$d albums</item>
    </plurals>
    <plurals name="library_artist_count">
        <item quantity="one">%1$d artist</item>
        <item quantity="other">%1$d artists</item>
    </plurals>
    <plurals name="library_playlist_count">
        <item quantity="one">%1$d playlist</item>
        <item quantity="other">%1$d playlists</item>
    </plurals>
    <string name="library_empty_tracks">No tracks yet</string>
    <string name="library_empty_albums">No albums yet</string>
    <string name="library_empty_artists">No artists yet</string>
    <string name="library_empty_playlists">No playlists yet</string>
