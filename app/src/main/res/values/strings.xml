    <string name="nav_albums">Albums</string>
    <string name="nav_artists">Artists</string>
    <string name="nav_playlists">Playlists</string>
    <string name="nav_search">Search</string>
    <string name="nav_back">Back</string>

    <!-- Source names. Product names, never translated. -->
    <string name="source_plex" translatable="false">Plex</string>
