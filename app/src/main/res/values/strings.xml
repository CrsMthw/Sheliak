    <string name="source_samba" translatable="false">Samba</string>
    <string name="source_local">This device</string>

    <!-- Intro (first run) -->
    <string name="intro_title">Welcome to Sheliak</string>
    <string name="intro_subtitle">One library for all your music, wherever it lives.</string>
    <string name="intro_source_plex_desc">Stream from your Plex Media Server</string>
    <string name="intro_source_local_desc">Music files stored on this phone</string>
    <string name="intro_source_jellyfin_desc">Stream from your Jellyfin server</string>
    <string name="intro_source_samba_desc">Music on a shared network folder</string>
    <!-- Shown on a source card that cannot be connected yet -->
    <string name="intro_coming_next">Coming next</string>
    <!-- Shown on a source card that can be connected now (Plex) -->
    <string name="intro_available">Available</string>
    <string name="intro_skip">Skip for now</string>
