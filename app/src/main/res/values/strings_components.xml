<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared components and utilities (ui/components, util). Screen strings live in strings.xml. -->

    <!-- Total running time of an album or playlist (util/Extensions.kt toDurationString).
         Abbreviated units: %1$d is whole hours, %2$d the remaining whole minutes. -->
    <string name="duration_hours_minutes">%1$dh %2$dm</string>
    <!-- Total running time under one hour. %1$d is whole minutes. -->
    <string name="duration_minutes">%1$dm</string>

    <!-- Detail hero buttons (ui/components/DetailArtHero.kt) and the playlist card's play button -->
    <string name="detail_play">Play</string>
    <string name="detail_shuffle">Shuffle</string>

    <!-- A track's long-press menu (ui/components/TrackActionsMenu.kt). track_actions is TalkBack's long-press label. -->
    <string name="track_actions">Track actions</string>
    <string name="track_play_next">Play next</string>
    <string name="track_add_to_queue">Add to queue</string>
    <string name="track_go_to_album">Go to album</string>
    <string name="track_go_to_artist">Go to artist</string>
</resources>
