<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the library index is rebuilt from its sources, and provider credentials and
     server tokens must never be restored onto another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
